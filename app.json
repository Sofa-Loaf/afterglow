{
  "expo": {
    "name": "Afterglow",
    "slug": "afterglow",
    "owner": "www.28to3.me",
    "scheme": "afterglow",
    "version": "0.1.1",
    "orientation": "portrait",
    "icon": "./assets/brand/afterglow-app-icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/brand/afterglow-wordmark.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "me.to28.afterglow",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Afterglow uses GPS to notice when you leave, and to let you hear a whisper only at the same spot — about fifty feet. It does not show who is here.",
        "NSMicrophoneUsageDescription": "Afterglow records an 8–12 second voice note only after you start recording.",
        "NSCameraUsageDescription": "Afterglow takes a still photo you choose to leave. A face is not required."
      }
    },
    "android": {
      "package": "me.to28.afterglow",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/afterglow-app-icon.png",
        "backgroundColor": "#0a0a0b"
      },
      "softwareKeyboardLayoutMode": "resize",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "RECORD_AUDIO",
        "CAMERA"
      ],
      "blockedPermissions": [
        "ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/brand/afterglow-wordmark.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/brand/afterglow-wordmark.png"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Afterglow uses GPS to notice when you leave, and to let you hear a whisper only at the same spot — about fifty feet. It does not show who is here.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Afterglow records an 8–12 second voice note only after you start recording.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Afterglow takes a still photo you choose to leave. A face is not required.",
          "photosPermission": "Afterglow can use a still you already took. A face is not required."
        }
      ]
    ],
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#000000",
      "translucent": true
    },
    "androidNavigationBar": {
      "barStyle": "light-content",
      "backgroundColor": "#0a0a0b"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "freeForever": true,
      "payments": "none",
      "androidPackage": "me.to28.afterglow",
      "eas": {
        "projectId": "cb3c3a77-19bd-4e3a-ae5e-69f4101dbcec"
      }
    }
  }
}
